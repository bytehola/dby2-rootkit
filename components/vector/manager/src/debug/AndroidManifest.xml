<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions.

  This file contributes the explicit demo activity to debug builds and contributes nothing at all
  to a release build, because a release build never reads it. It stays out of the launcher so the
  installed user-facing icon always opens the working parasitic manager.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Reaching the demo must never be something a user can do by accident, and it must not
          require the manager to be in a working state to get to — several of the scenarios exist
          precisely because the app is not working.
        -->
        <activity
            android:name="org.matrix.vector.manager.demo.DemoActivity"
            android:exported="true"
            android:label="Vector demo states"
            android:taskAffinity="org.matrix.vector.manager.demo" />
    </application>
</manifest>
